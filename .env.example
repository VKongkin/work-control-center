# Database Configuration
DATABASE_URL=postgresql://wcc_user:wcc_password@db:5432/wcc_db
SQL_ECHO=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# --------------------------------------------------------------- reachability
# Adminer (8080) and Postgres (5432) are bound to this machine only. Adminer is
# a database console with no password of its own and Postgres still has the
# default one, so neither should answer the network. Override only if you
# really need them remotely - and change POSTGRES_PASSWORD first.
# DB_BIND=0.0.0.0
# ADMINER_BIND=0.0.0.0
#
# The app itself listens on every interface so other machines (and the Copilot
# agent interface) can reach it. Set this to keep the whole thing local:
# BIND_HOST=127.0.0.1

# Environment
ENVIRONMENT=development

# ---------------------------------------------------------------- calendars
# Leave these alone unless CALENDAR.md tells you otherwise.
# WCC_AUTO_SYNC=1
# WCC_SYNC_TICK_SECONDS=60
# WCC_TIMEZONE=Asia/Phnom_Penh
# Encrypts stored Microsoft sign-in tokens. Generated and kept in the database
# if unset, so a laptop install needs no setup.
# WCC_SECRET_KEY=

# ------------------------------------------------------------------- vault
# Encrypts server passwords on the Servers page. There is no fallback: without
# this, the inventory works but storing a password is refused, deliberately -
# a key kept beside the passwords it protects is decoration.
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Keep the real one in your own password manager, not in a file you commit.
# WCC_VAULT_KEY=

# ------------------------------------------------------------------- agent
# Turns on the Copilot / MCP interface and is the key it requires. Unset means
# every agent route returns 401. See COPILOT.md.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# WCC_AGENT_KEY=
#
# Let the agent see account usernames as well as servers. Never a password.
# WCC_AGENT_EXPOSE_ACCOUNTS=0

# ----------------------------------------------------------------- assistant
# The model behind the Assistant page. It uses the same eight tools the agent
# interface publishes, so it can search your runbooks and raise your tasks -
# but the loop runs here, so there is no MCP client to install and no key to
# paste in every morning. Unset WCC_LLM_MODEL means the page says so politely
# and does nothing; the rest of WCC is unaffected.
#
# Free and local - LM Studio on this machine (see COPILOT.md for the walk-through):
# WCC_LLM_BASE_URL=http://host.docker.internal:1234/v1
# WCC_LLM_MODEL=qwen2.5-7b-instruct
#
# Ollama on this machine:
# WCC_LLM_BASE_URL=http://host.docker.internal:11434/v1
# WCC_LLM_MODEL=qwen2.5:7b
#
# Azure OpenAI, when the company licence arrives. The base URL ends at the
# deployment; the model name is the deployment name.
# WCC_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# WCC_LLM_MODEL=<deployment>
# WCC_LLM_API_KEY=
# WCC_LLM_API_VERSION=2024-10-21
#
# Azure is the only one that needs WCC_LLM_API_VERSION - without it, Azure
# answers 404 and nothing explains why. Leave it unset for everything else.
#
# Sent as both `Authorization: Bearer` and `api-key`, so the same variable works
# whichever of the two the endpoint expects. Anything OpenAI-compatible will do.
